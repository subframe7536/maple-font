{
  "$schema": "../cjk_schema.json",
  "locale_name": "CN",
  "source": {
    "path": "../variable-source/WenYuanRoundedSCVF.ttf",
    "download": {
      "url": "https://github.com/takushun-wu/WenYuanFonts/releases/download/v1.110/WenYuanRoundedSCVF.ttf"
    },
    "drop_tables": ["BASE", "VVAR", "vhea", "vmtx"],
    "masters": {
      "100": {
        "ital": 0,
        "wght": 250
      },
      "400": {
        "ital": 0,
        "wght": 470
      },
      "800": {
        "ital": 0,
        "wght": 900
      }
    }
  },
  "unicode": {
    "ranges": [
      "0x2460-0x24FF",
      "0x2E80-0x2EFF",
      "0x2F00-0x2FDF",
      "0x2FF0-0x2FFF",
      "0x3000-0x303F",
      "0x3040-0x30FF",
      "0x3100-0x312F",
      "0x31A0-0x31EF",
      "0x3200-0x33FF",
      "0x3400-0x4DBF",
      "0x4E00-0x9FFF",
      "0xF900-0xFAFF",
      "0xFE30-0xFE6F",
      "0xFF00-0xFFEF"
    ],
    "exclude_feature_codepoints": true
  },
  "transform": {
    "target_advance_width": 1200,
    "x_scale": 1.02,
    "y_scale": 1.05,
    "x_shift": 100,
    "y_shift": -25,
    "italic_angle": 10
  }
}
