},
{
code = "  cvParameters {
    FeatUILabelNameID {
      name \"CV65: Alternative & in handwriting style\";
    };
  };

  sub ampersand by ampersand.cv65;
  sub ampersand_ampersand.liga by ampersand_ampersand.liga.cv65;
