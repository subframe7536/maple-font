  sub rcommaaccent by rcommaaccent.cv41;";
tag = cv41;
},
{
code = "  cvParameters {
    FeatUILabelNameID {
      name \"CV61: Alternative , and ; with straight tail\";
    };
  };

  sub comma by comma.cv61;
  sub semicolon by semicolon.cv61;
  sub semicolon_semicolon.liga by semicolon_semicolon.liga.cv61;
