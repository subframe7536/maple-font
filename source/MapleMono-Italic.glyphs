  # Cl
  lookup C_l.liga {
    ignore sub C' l l;
    sub SPC l' by C_l.liga;
    sub C' l by SPC;
  } C_l.liga;

  # al
  lookup a_l.liga {
    ignore sub a' l l;
    sub SPC l' by a_l.liga;
    sub a' l by SPC;
  } a_l.liga;

  # cl
  lookup c_l.liga {
    ignore sub c' l l;
    sub SPC l' by c_l.liga;
    sub c' l by SPC;
  } c_l.liga;

  # el
  lookup e_l.liga {
    ignore sub e' l l;
    sub SPC l' by e_l.liga;
    sub e' l by SPC;
  } e_l.liga;

  # il
  lookup i_l.liga {
    ignore sub i' l l;
    sub SPC l' by i_l.liga;
    sub i' l by SPC;
  } i_l.liga;

  # tl
