    ignore sub x' l l;
    sub SPC l' by x_l.liga;
    sub x' l by SPC;
  } x_l.liga;

  # ff
  lookup f_f.liga {
    ignore sub f f' f;
    ignore sub f' f f;
    sub SPC f' by f_f.liga;
    sub f' f by SPC;
  } f_f.liga;

  # tt
  lookup t_t.liga {
    ignore sub t t' t;
    ignore sub t' t [t l];
    sub SPC t' by t_t.liga;
    sub t' t by SPC;
  } t_t.liga;

  # all
  lookup a_l_l.liga {
    ignore sub a' l l l;
    sub SPC SPC l' by a_l_l.liga;
    sub SPC l' l by SPC;
    sub a' l l by SPC;
  } a_l_l.liga;

  # ell
  lookup e_l_l.liga {
