    };
  };

  sub J by J.cv40;
  sub Jcircumflex by Jcircumflex.cv40;
  sub J.bg by J.bg.cv40;";
tag = cv40;
},
{
code = "  cvParameters {
    FeatUILabelNameID {
      name \"CV41: Alternative italic r with bottom bar\";
    };
  };

  sub r by r.cv41;
