{
  "$schema": "./source/schema.json",
  "family_name": "Maple Mono",
  "use_hinted": true,
  "pool_size": 4,
  "ligature": false,
  "feature_freeze": {
    "calt": "freeze",
    "cv01": "freeze",
    "cv02": "freeze",
    "cv04": "freeze",
    "cv31": "freeze",
    "cv33": "freeze",
    "cv34": "freeze",
    "cv35": "freeze",
    "cv36": "freeze",
    "cv37": "freeze",
    "ss01": "freeze",
    "ss02": "freeze",
    "ss04": "freeze",
    "ss07": "freeze"
  },
  "nerd_font": {
    "enable": false,
    "version": "3.4.0",
    "mono": false,
    "use_font_patcher": false,
    "glyphs": [
      "--complete"
    ],
    "extra_args": []
  },
  "cn": {
    "enable": false,
    "with_nerd_font": true,
    "fix_meta_table": true,
    "clean_cache": false,
    "narrow": false,
    "use_hinted": false,
    "use_static_base_font": true
  }
}
