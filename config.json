{
  "$schema": "./source/schema.json",
  "family_name": "Maple Mono",
  "use_hinted": true,
  "pool_size": 4,
  "ligature": false,
  "feature_freeze": [
    "calt", "cv01", "cv02", "cv04", "cv31", "cv33",
    "cv34", "cv35", "cv36", "cv37", "ss01", "ss02", "ss04", "ss07"
  ],
  "nerd_font": {
    "enable": false,
    "version": "3.4.0",
    "mono": false,
    "use_font_patcher": false,
    "glyphs": [
      "--complete"
    ],
    "extra_args": []
  },
  "cn": {
    "enable": false,
    "with_nerd_font": true,
    "fix_meta_table": true,
    "clean_cache": false,
    "narrow": false,
    "use_hinted": false,
    "use_static_base_font": true
  }
}
