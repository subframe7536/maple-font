{
  "$schema": "./sources/schema.json",
  "family_name": "Maple Mono",
  "font_version": "8.001",
  "formats": [
    "ttf",
    "otf",
    "woff2"
  ],
  "use_hinted": true,
  "standard_zero": false,
  "pool_size": 4,
  "ttfautohint_param": {},
  "github_mirror": "github.com",
  "infinite_arrow": true,
  "remove_tag_liga": false,
  "weight_mapping": {
    "thin": 100,
    "extralight": 200,
    "light": 300,
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700,
    "extrabold": 800
  },
  "codepoint_alias": {},
  "line_height": 1.0,
  "width": "default",
  "feature_freeze": {
    "cv01": "ignore",
    "cv02": "ignore",
    "cv03": "ignore",
    "cv04": "ignore",
    "cv05": "ignore",
    "cv06": "ignore",
    "cv07": "ignore",
    "cv08": "ignore",
    "cv09": "ignore",
    "cv10": "ignore",
    "cv11": "ignore",
    "cv12": "ignore",
    "cv31": "ignore",
    "cv32": "ignore",
    "cv33": "ignore",
    "cv34": "ignore",
    "cv35": "ignore",
    "cv36": "ignore",
    "cv37": "ignore",
    "cv38": "ignore",
    "cv39": "ignore",
    "cv40": "ignore",
    "cv41": "ignore",
    "cv42": "ignore",
    "cv43": "ignore",
    "cv44": "ignore",
    "cv45": "ignore",
    "cv61": "ignore",
    "cv62": "ignore",
    "cv63": "ignore",
    "cv64": "ignore",
    "cv65": "ignore",
    "cv66": "ignore",
    "cv67": "ignore",
    "cv68": "ignore",
    "cv96": "ignore",
    "cv97": "ignore",
    "cv98": "ignore",
    "cv99": "ignore",
    "ss01": "ignore",
    "ss02": "ignore",
    "ss03": "ignore",
    "ss04": "ignore",
    "ss05": "ignore",
    "ss06": "ignore",
    "ss07": "ignore",
    "ss08": "ignore",
    "ss09": "ignore",
    "ss10": "ignore",
    "ss11": "ignore",
    "ss12": "ignore",
    "ss13": "ignore",
    "zero": "ignore"
  },
  "nerd_font": {
    "enable": true,
    "version": "3.5.0",
    "mono": false,
    "propo": false,
    "variable": false,
    "use_font_patcher": false,
    "glyphs": [
      "--complete"
    ],
    "extra_args": []
  },
  "cjk": {
    "variable": false,
    "locales": {
      "cn": false,
      "jp": false,
      "tc": false,
      "kr": false,
      "custom": []
    },
    "with_nerd_font": true,
    "fix_meta_table": true,
    "clean_cache": false,
    "narrow": false,
    "use_hinted": false,
    "scale_factor": [
      1.0,
      1.0
    ]
  }
}